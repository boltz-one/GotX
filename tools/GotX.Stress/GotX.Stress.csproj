<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless deterministic stress scenarios (software renderer, virtual clock, fixed seeds). Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/GotX.Core/GotX.Core.csproj" />
    <ProjectReference Include="../../src/GotX.Raster/GotX.Raster.csproj" />
    <ProjectReference Include="../../src/GotX.Components/GotX.Components.csproj" />
    <!-- GeistFonts: deterministic font set, independent of the machine's system fonts -->
    <ProjectReference Include="../../samples/Shadcn/Shadcn.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="stress-baseline.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('stress-baseline.json')" />
  </ItemGroup>
</Project>
