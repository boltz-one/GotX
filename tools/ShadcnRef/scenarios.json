{
  "$doc": "Interaction-state scenarios shared by tools/ShadcnRef/states.mjs (reference, Edge + CDP real input) and samples/Shadcn/Capture/StateRunner.cs (GotX, headless). See samples/Shadcn/screenshots/README.md#states for the format.",
  "pages": [
    {
      "page": "home",
      "url": "https://ui.shadcn.com/",
      "hideHeader": true,
      "width": 1440,
      "height": 1829,
      "themes": ["light", "dark"],
      "targets": {
        "hero-badge": { "ref": { "selector": "[data-slot=badge]", "text": "Trace, Code Block and AI Elements" }, "gotx": { "key": "announcement" } },
        "get-started": { "ref": { "selector": "[data-slot=button]", "text": "Get Started" }, "gotx": { "key": "get-started" } },
        "view-components": { "ref": { "selector": "[data-slot=button]", "text": "View Components" }, "gotx": { "key": "view-components" } },
        "button-default": { "ref": { "selector": "button[data-slot=button]", "text": "Button" }, "gotx": { "key": "ui-button" } },
        "button-secondary": { "ref": { "selector": "button[data-slot=button]", "text": "Secondary" }, "gotx": { "key": "ui-secondary" } },
        "button-outline": { "ref": { "selector": "button[data-slot=button]", "text": "Outline" }, "gotx": { "key": "ui-outline" } },
        "input-name": { "ref": { "selector": "input[placeholder=\"Name\"]" }, "gotx": { "key": "ui-name" } },
        "textarea-message": { "ref": { "selector": "textarea[placeholder=\"Message\"]" }, "gotx": { "key": "ui-message" } },
        "radio-first": { "ref": { "selector": "[data-slot=radio-group-item]", "index": 0 }, "gotx": { "key": "ui-radio", "pick": 0 } },
        "radio-second": { "ref": { "selector": "[data-slot=radio-group-item]", "index": 1 }, "gotx": { "key": "ui-radio", "pick": 1 } },
        "checkbox": { "ref": { "selector": "[data-slot=checkbox]", "index": 0 }, "gotx": { "key": "ui-checkbox", "pick": 0 } },
        "switch": { "ref": { "selector": "[data-slot=switch]", "index": 0 }, "gotx": { "key": "ui-switch", "pick": 0 } },
        "alert-dialog": { "ref": { "selector": "[data-slot=alert-dialog-trigger]" }, "gotx": { "key": "ui-alert-open" } },
        "group-button": { "ref": { "selector": "button[data-slot=button]", "text": "Button Group" }, "gotx": { "key": "ui-group-button" } },
        "group-menu": { "ref": { "selector": "[data-slot=dropdown-menu-trigger][aria-label=\"Open quick actions\"]" }, "gotx": { "key": "ui-group-button", "next": 0 } },
        "sidebar-active": { "ref": { "selector": "[data-slot=sidebar-menu-button]", "text": "Analytics" }, "gotx": { "key": "nav-analytics" } },
        "sidebar-item": { "ref": { "selector": "[data-slot=sidebar-menu-button]", "text": "Transactions" }, "gotx": { "key": "nav-transactions" } },
        "select": { "ref": { "selector": "[data-slot=select-trigger]" }, "gotx": { "text": "USD — United States Dollar" } },
        "select-eur": { "ref": { "selector": "[data-slot=select-item]", "text": "EUR — Euro" }, "gotx": { "text": "EUR — Euro" } },
        "breadcrumb-home": { "ref": { "selector": "[data-slot=breadcrumb-link]", "text": "Home" }, "gotx": { "key": "payments-home" } },
        "payments-item": { "ref": { "selector": "a[data-slot=item]", "prefix": "Change transfer limit" }, "gotx": { "key": "payments-limit" } },
        "forgot-link": { "ref": { "selector": "a", "text": "Forgot?" }, "gotx": { "key": "forgot-password" } },
        "update-security-disabled": { "ref": { "selector": "button[data-slot=button]", "text": "Update Security" }, "gotx": { "key": "update-security" } },
        "dismiss-payout": { "ref": { "selector": "[aria-label=\"Dismiss payout threshold\"]" }, "gotx": { "key": "dismiss-payout" } },
        "chat-reset": { "ref": { "selector": "[data-slot=tooltip-trigger]" }, "gotx": { "key": "chat-reset" } },
        "chat-attach": { "ref": { "selector": "[data-slot=dropdown-menu-trigger][aria-label=\"Add files\"]" }, "gotx": { "key": "chat-composer", "pick": 0 } },
        "footer-link": { "ref": { "selector": "a", "text": "shadcn" }, "gotx": { "key": "footer-shadcn" } }
      },
      "states": [
        { "target": "hero-badge", "do": ["hover", "focus-key"] },
        { "target": "get-started", "do": ["hover", "focus-key", "press"] },
        { "target": "view-components", "do": ["hover", "focus-key", "press"] },
        { "target": "button-default", "do": ["hover", "focus-key", "press"] },
        { "target": "button-secondary", "do": ["hover", "focus-key", "press"] },
        { "target": "button-outline", "do": ["hover", "focus-key", "press"] },
        { "target": "input-name", "do": ["hover", "focus-key"] },
        { "name": "input-name-type", "steps": [{ "target": "input-name", "do": "type", "text": "Ada Lovelace" }] },
        { "target": "textarea-message", "do": ["hover", "focus-key"] },
        { "target": "radio-first", "do": ["hover", "focus-key"] },
        { "target": "radio-second", "do": ["click"] },
        { "target": "checkbox", "do": ["hover", "focus-key", "click"] },
        { "target": "switch", "do": ["hover", "focus-key", "click"] },
        { "target": "alert-dialog", "do": ["hover", "focus-key", "click"] },
        { "target": "group-button", "do": ["hover"] },
        { "target": "group-menu", "do": ["hover", "focus-key", "click"] },
        { "target": "sidebar-active", "do": ["hover"] },
        { "target": "sidebar-item", "do": ["hover", "focus-key", "press", "click"] },
        { "target": "select", "do": ["hover", "focus-key", "click"] },
        { "name": "select-open-item-hover", "steps": [{ "target": "select", "do": "click" }, { "target": "select-eur", "do": "hover" }] },
        { "target": "breadcrumb-home", "do": ["hover", "focus-key"] },
        { "target": "payments-item", "do": ["hover", "focus-key"] },
        { "target": "forgot-link", "do": ["hover"] },
        { "target": "update-security-disabled", "do": ["hover"] },
        { "target": "dismiss-payout", "do": ["hover", "focus-key"] },
        { "target": "chat-reset", "do": ["hover", "focus-key"] },
        { "target": "chat-attach", "do": ["focus-key", "click"] },
        { "target": "footer-link", "do": ["hover"] }
      ]
    }
  ]
}
